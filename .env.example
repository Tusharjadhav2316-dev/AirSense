# AirSense AI Health Assistant — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Database
DATABASE_URL=sqlite:///./airsense.db

# Authentication Security
JWT_SECRET=change_this_to_a_random_32_plus_character_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth Server-Side Verification
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# OpenRouter AI Integration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-opus-5

# Backwards compatibility settings
LLM_PROVIDER=openrouter
LLM_API_KEY=

# Vector Database Persistence
CHROMA_PERSIST_DIR=./chroma_db

# Frontend Config
VITE_API_BASE_URL=http://localhost:8000
BACKEND_URL=https://backend-two-blush-37.vercel.app
